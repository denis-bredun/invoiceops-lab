# direnv
.envrc
**/.envrc
.direnv/
**/.direnv/

# Cloudflare local secrets.
.dev.vars
.dev.vars.*
**/.dev.vars
**/.dev.vars.*
!.dev.vars.example
!**/.dev.vars.example

# Local-only settings conventions
*.local.env
*.local.ini
*.local.toml
*.local.yaml
*.local.yml
*.local.json
**/appsettings.Local.json
**/appsettings.*.Local.json
**/appsettings.local.json
**/appsettings.*.local.json
**/settings.local.json
**/local.settings.json

# Explicit secret/credential directories
.secrets/
**/.secrets/
secrets.local/
**/secrets.local/
credentials.local/
**/credentials.local/
tokens.local/
**/tokens.local/

# Explicit local secret files
secrets.local.*
credentials.local.*
tokens.local.*
client-secret.local.*
service-principal.local.*

# Private keys / password-bearing certificate containers
*.pfx
*.p12
*.p8
*.p7b
*.key
*.pem
*.jks
*.keystore
*.kdbx
*.ovpn

# SSH/private key conventions if accidentally copied into the repository
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
*.ppk

# npm / Python publishing credentials
.npmrc.local
**/.npmrc.local
.pypirc
**/.pypirc

# IMPORTANT:
# Security-test fixtures used by RPA-125/RPA-149 must remain trackable even if
# they deliberately resemble secrets. Put only synthetic/fake secrets here.
!tests/fixtures/
!tests/fixtures/**
!tests/security-fixtures/
!tests/security-fixtures/**


# ==============================================================================
# 4. POWER PLATFORM / PAC CLI / DATAVERSE LOCAL AUTH STATE
# ==============================================================================

# PAC auth profiles are workstation state and must never become repository state.
# Current PAC normally stores profiles outside the repo, but these rules protect
# against accidental copy/export into the working tree.
.pac/
**/.pac/
.pac-cli/
**/.pac-cli/
.powerplatform/
**/.powerplatform/
.power-platform/
**/.power-platform/
.pp-tools/
**/.pp-tools/
AuthProfiles/
**/AuthProfiles/
authprofiles/
**/authprofiles/
pac-auth/
**/pac-auth/
pac-auth-cache/
**/pac-auth-cache/

# MSAL/PAC token cache names observed in Power Platform tooling ecosystems
tokencache_msal*.dat
**/tokencache_msal*.dat
tokenCache*.dat
**/tokenCache*.dat
msalcache*.bin*
**/msalcache*.bin*

# Never commit generated/local connection/auth profile dumps
*authprofile*.json
*auth-profile*.json
*authprofiles*.json
*auth-profiles*.json
*connectionprofile*.json
*connection-profile*.json
*.auth.local.json

# Deployment settings may contain environment-specific connection bindings.
# Track deliberate sanitized templates, ignore local resolved copies.
**/deploymentSettings.local.json
**/deployment-settings.local.json
**/settings.deployment.local.json

# Power Platform solution/package build outputs.
# The unpacked source under power-platform/solutions/ IS intended to be tracked.
power-platform/**/[Bb]in/
power-platform/**/[Oo]bj/
power-platform/**/[Oo]ut/
power-platform/**/dist/
power-platform/**/build/
power-platform/**/*.zip
power-platform/**/*.cab
power-platform/**/*.nupkg

# Temporary solution-checker / PAC output
power-platform/**/.pac/
power-platform/**/.checker/
power-platform/**/checker-results.local/
power-platform/**/solution-checker.local.*
power-platform/**/temp/
power-platform/**/tmp/


